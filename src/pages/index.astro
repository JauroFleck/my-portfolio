				</svg>
				<a href="https://wa.me/5512996773144" target="_blank" class="hover:underline">WhatsApp</a>
			</span>
		</div>
	</section>
</Layout>

<style>
	@keyframes fade-in {
		0% {
			opacity: 0;
			transform: translateY(20px);
		}
		100% {
			opacity: 1;
			transform: translateY(0);
		}
	}
	.animate-fade-in {
		animation: fade-in 0.8s ease-out;
	}
</style>